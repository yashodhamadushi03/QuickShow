# App Settings
PROJECT_NAME="QuickShow Cinema Reservation API"
API_V1_STR="/api"

# JWT Security
SECRET_KEY="quickshow_jwt_secret_key_production_ready_2026_super_secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL Database Configuration (MySQL Workbench / PyMySQL)
MYSQL_SERVER="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DB="quickshow_db"

# Database Connection URL (PyMySQL Driver)
DATABASE_URL="mysql+pymysql://root:your_mysql_password@localhost:3306/quickshow_db"
